# ============================================================
# KSP Hackathon Project - .gitignore
# FastAPI + React/Vite + Zoho Catalyst AppSail
# ============================================================


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

*.egg
*.egg-info/
.eggs/

# Python build artifacts
dist/
build/

# Python caches / tooling
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/


# ============================================================
# VIRTUAL ENVIRONMENTS
# ============================================================

.venv/
venv/
env/
ENV/

backend/.venv/


# ============================================================
# ENVIRONMENT VARIABLES / SECRETS
# ============================================================

# Never commit real environment files
.env
.env.*
*.env.local
*.local

backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Keep example environment files in Git
!.env.example
!backend/.env.example
!frontend/.env.example

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx


# ============================================================
# ZOHO CATALYST / APPSAIL
# ============================================================

# Generated AppSail deployment build.
# build_appsail.py recreates this with Linux dependencies.
backend/build/

# Catalyst local/generated state
.catalyst/

# IMPORTANT:
# Do NOT ignore these:
#
# catalyst.json
# backend/app-config.json
# backend/app_start.py
# backend/build_appsail.py
# backend/requirements.txt


# ============================================================
# FASTAPI / APPLICATION RUNTIME
# ============================================================

# Logs
*.log
logs/
backend/logs/

# Runtime / temporary files
tmp/
temp/
*.tmp
*.temp
*.pid
*.pid.lock

# Generated application output
generated/
exports/


# ============================================================
# TESTING / COVERAGE
# ============================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.tox/
.nox/


# ============================================================
# ALEMBIC
# ============================================================

# Keep migration files tracked.
# Only ignore generated Python cache.

alembic/__pycache__/
alembic/versions/__pycache__/

backend/alembic/__pycache__/
backend/alembic/versions/__pycache__/

# DO NOT ignore:
# backend/alembic/versions/*.py
# backend/alembic.ini


# ============================================================
# NODE / FRONTEND
# ============================================================

node_modules/
frontend/node_modules/

# Vite / frontend generated output
frontend/dist/
frontend/build/

# Framework build directories
.next/
.nuxt/
.output/

# Vite cache
.vite/
frontend/.vite/

# Package manager caches
.npm/
.pnpm-store/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*


# ============================================================
# IDE / EDITORS
# ============================================================

.vscode/
.idea/

*.swp
*.swo
*~

# Visual Studio
.vs/


# ============================================================
# OPERATING SYSTEM FILES
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini


# ============================================================
# LOCAL DATABASE FILES
# ============================================================

*.db
*.sqlite
*.sqlite3


# ============================================================
# LOCAL UPLOADS / GENERATED DATA
# ============================================================

uploads/
backend/uploads/


# ============================================================
# OPTIONAL LOCAL BACKUPS
# ============================================================

*.bak
*.backup
*.old