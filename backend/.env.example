DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scrb_dev
REDIS_URL=redis://localhost:6379/0
APP_NAME=SCRB Intelligence Platform
APP_ENV=local
SECRET_KEY=change-me-to-a-long-random-secret-key-before-deploying

# Google Gemini (Day 2 — AI Foundation)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60.0

# SMTP / Email Configuration (Optional: if not set, emails & OTPs print to console/terminal for local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@ksp.gov.in
SMTP_FROM_NAME=SCRB Intelligence Platform
FRONTEND_URL=http://localhost:8080
